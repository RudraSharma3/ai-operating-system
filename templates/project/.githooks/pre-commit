#!/usr/bin/env bash
# AI Operating System Pre-Commit Guard Hook (by Rudra Sharma)
# Protects against secret leaks and enforces task state hygiene.

echo "🔍 [AI-OS Guard] Checking commit for secret leaks and task state..."

# 1. Check for staged .env files
STAGED_ENV_FILES=$(git diff --cached --name-only -- ':!.githooks/*' | grep -E "^\.env$|^\.env\..+" || true)
if [ -n "$STAGED_ENV_FILES" ]; then
    echo ""
    echo "❌ [AI-OS Guard BLOCKED COMMIT]: Staged environment file(s) detected:"
    for f in $STAGED_ENV_FILES; do
        echo "   • $f"
    done
    echo ""
    echo "💡 QUICK FIX (Copy and paste to resolve):"
    echo "   1. Unstage secret file(s):"
    for f in $STAGED_ENV_FILES; do
        echo "      git reset $f"
    done
    echo "   2. Ensure it is in .gitignore: echo \"$STAGED_ENV_FILES\" >> .gitignore"
    echo "   3. Commit again:              git commit -m \"feat: your commit message\""
    echo ""
    exit 1
fi

# 2. Check for hardcoded API keys or private keys in staged diff (excluding .githooks itself)
STAGED_DIFF=$(git diff --cached -- ':!.githooks/*')
if echo "$STAGED_DIFF" | grep -E -q "sk-[a-zA-Z0-9]{20,}|anthropic-key|BEGIN (RSA|EC|PGP|OPENSSH) PRIVATE KEY"; then
    echo ""
    echo "❌ [AI-OS Guard BLOCKED COMMIT]: Potential private key or API token detected in staged code!"
    echo "💡 QUICK FIX:"
    echo "   1. Replace hardcoded secrets with environment variables (e.g. process.env.API_KEY)."
    echo "   2. Re-stage the cleaned files: git add ."
    echo "   3. Commit again:              git commit -m \"feat: your commit message\""
    echo ""
    exit 1
fi

echo "✅ [AI-OS Guard] Secret hygiene check passed. Clean commit!"
exit 0
